# OpsReportAgent environment configuration.
# Copy to .env and adjust. All values have safe offline defaults.

# Which LLM backend to use: stub | openai | anthropic
# "stub" is a deterministic offline provider used for tests and the demo.
LLM_PROVIDER=stub

# API keys (only required when the matching provider is selected)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model name for the selected provider (ignored by the stub provider)
MODEL_NAME=

# SQLAlchemy database URL. SQLite for local/demo, Postgres for production.
# Example Postgres: postgresql+psycopg2://ops:ops@localhost:5432/opsreport
DATABASE_URL=sqlite:///./opsreport.db

# Confidence threshold below which an extraction is routed to human review.
CONFIDENCE_THRESHOLD=0.75
